# ── NoName — environment template ────────────────────────────────────────
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
# Never commit the real `.env` file. All values below are placeholders.

# Application
APP_NAME=NoName
APP_ENV=development
LOG_LEVEL=INFO

# HTTP server (local WebApp/API). Use 127.0.0.1 for local development.
HOST=127.0.0.1
PORT=8000
USE_HTTPS=false

# Public base URL of the service (used by the WebApp and menu button).
# Example: WEBHOOK per Telegram requires a public HTTPS URL.
BASE_URL=http://localhost:8000

# Webhook mode. When true, the app registers a Telegram webhook at
# BASE_URL/telegram-webhook on startup. Default (false) uses long polling,
# which is fine for development.
WEBHOOK_ENABLED=false
WEBHOOK_SECRET=generate_a_long_random_secret

# ── Telegram ────────────────────────────────────────────────────────────
# Token from @BotFather. NEVER put a real token in this file if it will be
# committed; keep it in your private .env only.
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token

# Bot username used in referral links and menu texts (without @).
BOT_USERNAME=YourBotUsername

# Comma-separated numeric Telegram user IDs allowed to run admin commands.
# Example: 123456789,987654321
TELEGRAM_ADMIN_IDS=123456789

# Optional admin bot token (only if you run a separate admin bot).
ADMIN_BOT_TOKEN=

# Allows plain ?userId= auth for local frontend development (NEVER enable in prod).
DEV_MODE=false

# ── Database ────────────────────────────────────────────────────────────
# SQLite by default; the file is created automatically under ./data.
DB_URL=sqlite+aiosqlite:///./data/noname.db

# ── VPN provider ────────────────────────────────────────────────────────
# Built-in providers:
#   mock — offline provider, no network access, ideal for local development.
#   xui  — optional 3x-UI panel adapter (requires VPN_API_URL and VPN_PASSWORD).
VPN_PROVIDER=mock

# Host used to build placeholder links in mock mode (do not use a real host).
MOCK_VPN_HOST=example.invalid

# Panel settings for VPN_PROVIDER=xui (replace with your own infrastructure).
VPN_API_URL=https://panel.example.invalid:2053
VPN_API_TOKEN=
VPN_USERNAME=admin
VPN_PASSWORD=replace_with_your_panel_password

# Comma-separated inbound IDs on the panel to provision clients into.
VPN_INBOUND_IDS=1

# Optional public subscription URL base provided by the panel.
VPN_SUB_URL=https://sub.example.invalid

# ── Payments (optional adapters; disabled by default) ───────────────────
# 'none' disables all payment adapters. 'platega' enables the example
# Platega adapter — implement/select your own provider before production.
PAYMENT_PROVIDER=none

# Platega adapter settings (only used when PAYMENT_PROVIDER=platega).
# Replace ALL of these with your own merchant credentials.
PLATEGA_MERCHANT_ID=your_merchant_id
PLATEGA_SECRET=your_merchant_secret
PLATEGA_PAYMENT_METHOD=2
PLATEGA_WEBHOOK_VERIFY=true
PLATEGA_WEBHOOK_TOKEN=generate_a_long_random_token

# ── Tariffs and pricing (sample values — configure your own) ────────────
# Format: DAYS:PRICE-IN-DAYS,DAYS:PRICE,...
TARIFFS=3:10,30:99,90:249,180:449,365:849
TARIFF_DAILY_PRICE=10
REFERRAL_REWARD=10
TRIAL_DAYS=3
MIN_TOPUP=10
TOPUP_PRESETS=10,50,100,200,500

# Support link shown to users (replace with your own).
SUPPORT_URL=https://example.invalid/support